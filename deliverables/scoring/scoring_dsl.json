{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fifer.local/schemas/scoring-dsl-v1.json",
  "title": "FIFER Declarative Scoring DSL v1",
  "description": "Objective profile + weighted factors. Weights are relative; normalized internally so sum(weights)=1 within the profile.",
  "type": "object",
  "required": ["id", "version", "factors"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Objective profile id (e.g. sales_explosive, high_commission, viral_reach)."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the profile document."
    },
    "objective": {
      "type": "string",
      "description": "Human-readable objective key; may duplicate id."
    },
    "tag_weight_map": {
      "type": "object",
      "description": "Optional catalog map tag_name -> relative importance (used by tagWeightCoverage factors).",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/factor" }
    },
    "tie_break": {
      "type": "object",
      "description": "Ranking tie-breaker preferences when two scores are equal after rounding.",
      "additionalProperties": false,
      "properties": {
        "primary_factor_id": {
          "type": "string",
          "description": "Factor id whose contribution breaks ties (default: first factor in factors[])."
        },
        "secondary": {
          "type": "string",
          "enum": ["product_id_asc", "product_id_desc"],
          "default": "product_id_asc"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "normalizeRange": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "invert": {
          "type": "boolean",
          "description": "If true, maps high raw values to low normalized scores."
        }
      }
    },
    "factor": {
      "oneOf": [
        {
          "title": "pathFactor",
          "type": "object",
          "required": ["id", "weight", "path"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "weight": { "type": "number", "exclusiveMinimum": 0 },
            "path": { "type": "string", "description": "Dot path on input (e.g. metrics.commission_rate)" },
            "normalize": { "$ref": "#/$defs/normalizeRange" }
          }
        },
        {
          "title": "tagOverlapFactor",
          "type": "object",
          "required": ["id", "weight", "fn", "tags"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "weight": { "type": "number", "exclusiveMinimum": 0 },
            "fn": { "const": "tagOverlap" },
            "tags": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "Required tag names; score = hits / len(tags)."
            }
          }
        },
        {
          "title": "tagWeightCoverageFactor",
          "type": "object",
          "required": ["id", "weight", "fn", "tag_weights"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "weight": { "type": "number", "exclusiveMinimum": 0 },
            "fn": { "const": "tagWeightCoverage" },
            "tag_weights": {
              "type": "object",
              "additionalProperties": { "type": "number", "minimum": 0 },
              "description": "Sum of weights for tags present on product / sum of all weights in map -> [0,1]."
            }
          }
        },
        {
          "title": "literalFactor",
          "type": "object",
          "required": ["id", "weight", "literal"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "weight": { "type": "number", "exclusiveMinimum": 0 },
            "literal": { "type": "number" },
            "normalize": { "$ref": "#/$defs/normalizeRange" }
          }
        }
      ]
    }
  }
}
