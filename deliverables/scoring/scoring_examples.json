{
  "schema": "fifer.scoring.worked_example_v1",
  "normalization_reference": {
    "W": "sum of factor weights in the profile",
    "share_i": "weight_i / W",
    "norm_i": "factor-specific normalized score in [0,1]",
    "contrib_i": "share_i * norm_i * 100",
    "score": "clamp( round_half_up( sum_i contrib_i, 3 ), 0, 100 )"
  },
  "examples": [
    {
      "example_id": 1,
      "objective": "sales_explosive",
      "profile": {
        "id": "sales_explosive",
        "version": "1.0.0",
        "objective": "Maximize impulse + discount fit with sales velocity",
        "tag_weight_map": {
          "intent_impulse": 0.4,
          "discount_flash": 0.35,
          "publish_ig": 0.25
        },
        "factors": [
          {
            "id": "impulse_tag_fit",
            "weight": 0.5,
            "fn": "tagWeightCoverage",
            "tag_weights": {
              "intent_impulse": 0.4,
              "discount_flash": 0.35,
              "publish_ig": 0.25
            }
          },
          {
            "id": "sales_velocity",
            "weight": 0.3,
            "path": "metrics.sales_velocity_index",
            "normalize": {
              "min": 0,
              "max": 100
            }
          },
          {
            "id": "urgency_overlap",
            "weight": 0.2,
            "fn": "tagOverlap",
            "tags": [
              "limited_stock",
              "flash_window"
            ]
          }
        ],
        "tie_break": {
          "primary_factor_id": "impulse_tag_fit",
          "secondary": "product_id_asc"
