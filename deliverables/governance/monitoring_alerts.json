{
  "version": "1.0.0",
  "alerts": [
    {
      "id": "credits_estimated_vs_actual",
      "metric": "credits_estimated_vs_actual_ratio",
      "condition": "rolling_24h_sum(actual)/sum(estimated) > 1.25",
      "severity": "warning",
      "owner": "platform"
    },
    {
      "id": "credits_daily_spike",
      "metric": "credits_daily_total",
      "condition": "> 7d_baseline * 2",
      "severity": "critical",
      "owner": "platform"
    },
    {
      "id": "credit_simulator_errors",
      "metric": "simulateScenario_error_rate",
      "condition": "unknown_engine + unit_mismatch > 1% of calls",
      "severity": "warning",
      "owner": "platform"
    },
    {
      "id": "tag_batch_update_spike",
      "metric": "fifer_platform_tags_updates_per_minute",
      "condition": "> N (baseline-derived)",
      "severity": "warning",
      "owner": "security"
    },
    {
      "id": "tag_actor_drift",
      "metric": "tag_history_changed_by_not_in_allowlist",
      "condition": "count > 0 in 15m",
      "severity": "critical",
      "owner": "security"
    },
    {
      "id": "tag_type_fk_errors",
      "metric": "postgres_error_fk_fifer_tags_tag_type_slug",
      "condition": "count > 0",
      "severity": "critical",
      "owner": "platform"
    }
  ]
}
