{
  "play_id": "viral_growth_v1",
  "version": "1.0.0",
  "objective": "viral_growth",
  "summary": "Maximize reach and share velocity: rank by viral_reach profile, short punchy reels, trend-aligned tags, aggressive A/B on first 3s hook; lower direct CVR acceptable.",
  "product_selection": {
    "source": "tag_ranking",
    "scoring_profile_id": "viral_reach",
    "filters": {
      "min_score": 50,
      "top_n": 30,
      "require_tags_any": ["hook_strong", "publish_ig", "trending_audio", "video_realism_level:standard"],
      "boost_metrics": { "engagement_rate": 0.06, "shares_per_hour": 120 }
    },
    "refresh_policy": {
      "job_type": "rank_refresh",
      "cron": "*/30 * * * *",
      "note": "Frequent refresh for trend windows (optional: cap 12 runs/day)"
    }
  },
  "content_formats": [
    {
      "format": "reel",
      "duration_seconds": 12,
      "variants_per_product": 3,
      "hook_style": "pattern_interrupt",
      "cta": "sound_on_save"
    },
    {
      "format": "post",
      "length": "micro_caption",
      "variants_per_product": 2,
      "cta": "comment_tag"
    },
    {
      "format": "carousel",
      "slides": 3,
      "variants_per_product": 1,
      "cta": "share"
    }
  ],
  "ai_engines": {
    "script_and_structure": "gemini_flash_text",
    "voice": "elevenlabs_tts",
    "video": "runway_video",
    "stills": "leonardo_image",
    "trend_lookup": "gemini_flash_text",
    "publish_fanout": "make_webhook"
  },
  "estimated_credits": {
    "method": "simulateScenario",
    "reference_lines": [
      { "engineId": "runway_video", "unit": "1s_render", "qty": 12, "note": "per reel" },
      { "engineId": "gemini_flash_text", "unit": "1k_tokens", "qty": 0.45, "note": "hook variants" },
      { "engineId": "elevenlabs_tts", "unit": "1k_chars", "qty": 0.25, "note": "short VO" },
      { "engineId": "leonardo_image", "unit": "1_image", "qty": 1, "note": "thumb" }
    ],
    "scenario_overrides": {
      "variation": { "outputs": 3, "multiplier": 1.05 },
      "parallel": { "jobs": 4, "coordinationOverheadPerExtraJob": 0.05 },
      "retries": { "attempts": 2, "successRate": 0.85, "costFractionPerAttempt": 1 },
      "transcoding": { "overheadPct": 0.08 }
    },
    "per_product_band_credits": { "min": 40, "max": 95 },
    "campaign_total_band_credits": { "min": 1200, "max": 2850, "assumes_products": 30 }
  },
  "timeline": {
    "timezone": "America/Los_Angeles",
    "phases": [
      { "phase": "trend_scan", "days": 1, "tasks": ["audio_trends", "hashtag_map"] },
      { "phase": "burst", "days": 4, "tasks": ["3x_daily_posts", "hook_ab"] },
      { "phase": "amplify", "days": 5, "tasks": ["winner_boost", "duet_stitch_prompts"] },
      { "phase": "sustain", "days": 7, "tasks": ["ugc_remix", "carousel_recap"] },
      { "phase": "handoff", "days": 2, "tasks": ["retarget_to_sales", "crm_export"] }
    ],
    "total_calendar_days": 19
  },
  "kpis": [
    { "id": "views", "name": "Total views", "target": 500000, "unit": "count" },
    { "id": "share_rate", "name": "Shares / views", "target": 0.012, "unit": "ratio" },
    { "id": "follower_delta", "name": "Net new followers", "target": 8000, "unit": "count" },
    { "id": "avg_watch_time_pct", "name": "Avg watch time / length", "target": 0.45, "unit": "ratio" },
    { "id": "cvr", "name": "Conversion rate (secondary)", "target": 0.012, "unit": "ratio" }
  ],
  "ab_rollout": {
    "strategy": "multi_cell_hook_matrix",
    "variants": [
      {
        "id": "A",
        "label": "Trend_audio",
        "weight": 0.34,
        "creative_bias": { "audio": "trending", "hook": "visual_twist" }
      },
      {
        "id": "B",
        "label": "Controversy_take",
        "weight": 0.33,
        "creative_bias": { "audio": "original", "hook": "hot_take" }
      },
      {
        "id": "C",
        "label": "Tutorial_tease",
        "weight": 0.33,
        "creative_bias": { "audio": "voiceover", "hook": "how_to_in_3s" }
      }
    ],
    "phases": [
      { "name": "explore", "duration_days": 3, "traffic": { "A": 0.34, "B": 0.33, "C": 0.33 } },
      { "name": "exploit", "duration_days": 7, "traffic": { "top2": 0.85, "rest": 0.15 } },
      { "name": "scale_winner", "duration_days": 9, "traffic": { "winner": 0.9, "challenger": 0.1 } }
    ],
    "promotion_rule": "Rank variants by share_rate * views^0.5; promote top variant +10% every 12h until 90/10.",
    "guardrails": {
      "brand_safety": "block_list_keywords",
      "max_posts_per_day_per_channel": 8,
      "min_impressions_per_cell_per_day": 4000
    }
  },
  "affiliate_integration": {
    "prefer_networks": ["admitad_aliexpress", "tiktok_shop_proxy"],
    "link_enrichment": "append_utm_content_variant",
    "disclosure": "required_overlay_first_frame"
  }
}
