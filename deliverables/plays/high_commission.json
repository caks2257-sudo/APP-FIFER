{
  "play_id": "high_commission_v1",
  "version": "1.0.0",
  "objective": "high_commission",
  "summary": "Prioritize affiliate margin: rank by commission + AOV tags, longer explainers, fewer but richer creatives; compliance-forward copy.",
  "product_selection": {
    "source": "tag_ranking",
    "scoring_profile_id": "high_commission",
    "filters": {
      "min_score": 58,
      "top_n": 18,
      "require_tags_any": ["high_commission", "metric:price_midband"],
      "metrics_floor": { "commission_rate": 0.12 }
    },
    "refresh_policy": {
      "job_type": "rank_refresh",
      "cron": "0 8 * * *",
      "note": "Daily refresh; commission feeds change slower than impulse SKUs"
    }
  },
  "content_formats": [
    {
      "format": "carousel",
      "slides": 7,
      "variants_per_product": 2,
      "cta": "compare_save",
      "emphasis": "benefits_and_specs"
    },
    {
      "format": "post",
      "length": "long_caption",
      "variants_per_product": 1,
      "cta": "read_more_shop"
    },
    {
      "format": "reel",
      "duration_seconds": 30,
      "variants_per_product": 1,
      "cta": "learn_more",
      "emphasis": "trust_and_warranty"
    }
  ],
  "ai_engines": {
    "script_and_structure": "gemini_pro_text",
    "voice": "elevenlabs_tts",
    "video": "runway_video",
    "stills": "leonardo_image",
    "fact_check": "gemini_flash_text",
    "publish_fanout": "make_webhook"
  },
  "estimated_credits": {
    "method": "simulateScenario",
    "reference_lines": [
      { "engineId": "gemini_pro_text", "unit": "1k_tokens", "qty": 2.5, "note": "long carousel copy" },
      { "engineId": "leonardo_image", "unit": "1_image", "qty": 7, "note": "per carousel" },
      { "engineId": "runway_video", "unit": "1s_render", "qty": 30, "note": "per reel" },
      { "engineId": "elevenlabs_tts", "unit": "1k_chars", "qty": 1.2, "note": "VO" }
    ],
    "scenario_overrides": {
      "variation": { "outputs": 2, "multiplier": 1 },
      "parallel": { "jobs": 2, "coordinationOverheadPerExtraJob": 0.06 },
      "retries": { "attempts": 1, "successRate": 0.9, "costFractionPerAttempt": 1 },
      "transcoding": { "overheadPct": 0.1 }
    },
    "per_product_band_credits": { "min": 95, "max": 140 },
    "campaign_total_band_credits": { "min": 1710, "max": 2520, "assumes_products": 18 }
  },
  "timeline": {
    "timezone": "UTC",
    "phases": [
      { "phase": "feed_audit", "days": 2, "tasks": ["verify_commission_rates", "tag_backfill"] },
      { "phase": "creative_build", "days": 5, "tasks": ["carousel_first", "reel_second"] },
      { "phase": "compliance_review", "days": 1, "tasks": ["affiliate_disclosure", "claims_check"] },
      { "phase": "ab_long_form", "days": 10, "tasks": ["caption_a_b", "landing_page_match"] },
      { "phase": "optimize_margin", "days": 5, "tasks": ["trim_low_roas_skus", "refresh_rank"] }
    ],
    "total_calendar_days": 23
  },
  "kpis": [
    { "id": "epc", "name": "Earnings per click", "target": 0.18, "unit": "USD" },
    { "id": "commission_yield", "name": "Attributed commission / impressions", "target": 0.004, "unit": "USD" },
    { "id": "aov", "name": "Average order value (proxy)", "target": 65, "unit": "USD" },
    { "id": "refund_rate", "name": "Refund rate (proxy)", "target": 0.06, "unit": "ratio", "direction": "lower" },
    { "id": "credit_per_commission_usd", "name": "Credits per $ commission", "target": 0.35, "unit": "credits_per_usd" }
  ],
  "ab_rollout": {
    "strategy": "creative_split_longform",
    "variants": [
      {
        "id": "A",
        "label": "Specs_first",
        "weight": 0.5,
        "creative_bias": { "carousel_order": ["specs", "social_proof", "price"] }
      },
      {
        "id": "B",
        "label": "Savings_first",
        "weight": 0.5,
        "creative_bias": { "carousel_order": ["savings", "specs", "warranty"] }
      }
    ],
    "phases": [
      { "name": "balanced", "duration_days": 5, "traffic": { "A": 0.5, "B": 0.5 } },
      { "name": "optimize", "duration_days": 10, "traffic": { "A": 0.5, "B": 0.5 } },
      { "name": "winner_take_most", "duration_days": 8, "traffic": { "winner": 0.75, "loser": 0.25 } }
    ],
    "promotion_rule": "Winner = higher epc; if tie, higher commission_yield; tie-breaker lexicographic product_id of top seller.",
    "guardrails": { "min_impressions_per_variant_per_day": 500, "stat_sig": "approx_bayesian_stop_after_7d_or_3000_clicks" }
  },
  "affiliate_integration": {
    "prefer_networks": ["impact", "shareasale", "amazon"],
    "link_enrichment": "subid_per_variant",
    "disclosure": "required_first_slide"
  }
}
