// FIFER — persistencia Supabase vía Prisma (Ordenanza §8)
// ADN multi-tenant: ownerId + mainApp (+ subApp opcional) + metadata Json.
// Mantener alineado con _xray_DATABASE.md (misbots, contratos) y prisma/_xray_DATABASE_GLOBAL.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InternalApiKeyScope {
  READ_ONLY
  FULL_ACCESS
}

enum TransactionType {
  INGRESO
  EGRESO
}

enum TransactionStatus {
  PENDIENTE
  COMPLETADO
  FALLIDO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("user")
  tier      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expediente       Expediente?
  financialAccount FinancialAccount?
  bots             Bot[]
  contracts        Contract[]
  documents        Document[]
  internalApiKeys  InternalApiKey[]
}

/// Expediente municipal 1:1 con `User` — identificación legal persistida (no sustituye `User.name` en flujos legacy).
model Expediente {
  id              String   @id @default(cuid())
  userId          String   @unique
  rut             String   @unique
  nombres         String
  apellidoPaterno String
  apellidoMaterno String
  nacionalidad    String
  fechaNacimiento DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Cuenta financiera 1:1 con `User` — saldo y moneda base para la app Finanzas.
model FinancialAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  currency  String   @default("CLP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

/// Movimiento contable asociado a una cuenta financiera.
model Transaction {
  id        String            @id @default(cuid())
  accountId String
  amount    Decimal           @db.Decimal(18, 2)
  currency  String            @default("CLP")
  type      TransactionType
  concept   String
  status    TransactionStatus
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// Llaves internas: qué App puede invocar qué Engine (Control de Flujo — .cursorrules §5).
model InternalApiKey {
  id                String              @id @default(cuid())
  name              String // ej. "Engine de Imágenes"
  apiKey            String              @unique // secreto o hash almacenado; nunca reutilizar en texto plano en logs
  scope             InternalApiKeyScope @default(READ_ONLY)
  targetAppOrEngine String // slug del Engine o App autorizado como destinatario de esta llave
  ownerId           String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([targetAppOrEngine])
}

model Bot {
  id        String   @id @default(cuid())
  name      String
  status    String
  modelId   String
  avatarUrl String?
  mainApp   String   @default("misbots")
  /// Columna legada en PostgreSQL (`sourceApp`) conservada para alinear `db push` con tablas que no ejecutaron el paso de renombre a `mainApp`.
  sourceApp String?
  subApp    String?
  metadata  Json?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([mainApp])
}

model Contract {
  id        String   @id @default(cuid())
  title     String
  status    String
  mainApp   String   @default("contratos")
  subApp    String?
  metadata  Json?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([mainApp])
}

model Document {
  id         String   @id @default(cuid())
  name       String
  fileUrl    String
  fileType   String
  size       Int
  bucketPath String
  mainApp    String
  subApp     String?
  metadata   Json?
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
  @@index([mainApp])
}
