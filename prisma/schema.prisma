// FIFER — persistencia Supabase vía Prisma (Ordenanza §8)
// ADN multi-tenant: ownerId + mainApp (+ subApp opcional) + metadata Json.
// Mantener alineado con _xray_DATABASE.md (misbots, contratos) y prisma/_xray_DATABASE_GLOBAL.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InternalApiKeyScope {
  READ_ONLY
  FULL_ACCESS
}

enum TransactionType {
  INGRESO
  EGRESO
}

enum TransactionStatus {
  PENDIENTE
  COMPLETADO
  FALLIDO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("user")
  tier      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expediente       Expediente?
  domExpedientes   DomExpediente[]
  financialAccount FinancialAccount?
  bots             Bot[]
  contracts        Contract[]
  documents        Document[]
  internalApiKeys  InternalApiKey[]
  aodsSessions     AodsSession[]
}

// --- AODS (AI Orchestrator Data System) — .cursorrules §25.4 ---

enum AodsSessionStatus {
  INIT
  NOTEBOOK
  GEMINI
  LOOP
  TEST
  DEPLOY
  DONE
}

enum AodsDocType {
  NOTEBOOK_PROMPT
  GEMINI_DOC
  UPDATE_DOC
}

enum AodsMessageRole {
  USER
  SYSTEM
  GEMINI
  CHATGPT
}

model AodsSession {
  id           String            @id @default(uuid())
  ownerId      String
  status       AodsSessionStatus @default(INIT)
  currentPhase String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  documents AodsDocument[]
  messages  AodsMessage[]
  state     AodsState?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model AodsDocument {
  id        String      @id @default(uuid())
  sessionId String
  type      AodsDocType
  /// Postgres JSONB: estructuras del Masterplan y artefactos versionados.
  content   Json
  version   Int         @default(1)
  createdAt DateTime    @default(now())

  session AodsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AodsMessage {
  id        String          @id @default(uuid())
  sessionId String
  role      AodsMessageRole
  content   String          @db.Text
  /// Tokens, ids de sub-llamadas, trazas, etc.
  metadata  Json?
  createdAt DateTime        @default(now())

  session AodsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AodsState {
  id               String   @id @default(uuid())
  sessionId        String   @unique
  currentStep      String?
  lastPrompt       String?  @db.Text
  lastResponse     String?  @db.Text
  /// Fase -1: historial { role, content }[] persistido al init (opcional).
  ideationHistory  Json?
  needsNotebook    Boolean  @default(false)
  needsUserAction  Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  session AodsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

/// Credenciales de integraciones externas (Bridge) — valores cifrados en reposo; clave maestra vía `FIFER_BRIDGE_MASTER_KEY`.
model ExternalBridgeCredential {
  id            String   @id @default(cuid())
  /// Nombre de variable de entorno lógica (ej. FLOW_API_KEY)
  envKey        String   @unique
  ciphertextB64 String
  ivB64         String
  authTagB64    String
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

/// Borradores de expediente DOM (formularios municipales generados vía `dom-engine:form-generator`).
model DomExpediente {
  id          String   @id @default(cuid())
  userId      String
  formType    String
  /// JSON del borrador generado (salida `MinvuFormMapper` / motor) o payload acordado por `formType`.
  projectData Json
  status      String   @default("DRAFT")
  mainApp     String   @default("dom")
  subApp      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Expediente municipal 1:1 con `User` — identificación legal persistida (no sustituye `User.name` en flujos legacy).
model Expediente {
  id              String   @id @default(cuid())
  userId          String   @unique
  rut             String   @unique
  nombres         String
  apellidoPaterno String
  apellidoMaterno String
  nacionalidad    String
  fechaNacimiento DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Cuenta financiera 1:1 con `User` — saldo y moneda base para la app Finanzas.
model FinancialAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  currency  String   @default("CLP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

/// Movimiento contable asociado a una cuenta financiera.
model Transaction {
  id             String            @id @default(cuid())
  accountId      String
  amount         Decimal           @db.Decimal(18, 2)
  currency       String            @default("CLP")
  type           TransactionType
  concept        String
  status         TransactionStatus
  /// Origen del registro: manual o importación bancaria (reconciliación).
  source         String            @default("manual")
  /// Id estable del movimiento en el proveedor bancario (deduplicación).
  bankExternalId String?
  /// Fecha contable reportada por el banco (puede diferir de createdAt).
  bankPostedAt   DateTime?
  /// Facturación electrónica (SII / Bridge billing): folio DTE.
  dteFolio       String?
  /// URL del PDF (mock o proveedor).
  dtePdfUrl      String?
  /// pendiente | emitido | error
  dteStatus      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, bankExternalId])
}

// Llaves internas: qué App puede invocar qué Engine (Control de Flujo — .cursorrules §5).
model InternalApiKey {
  id                String              @id @default(cuid())
  name              String // ej. "Engine de Imágenes"
  apiKey            String              @unique // secreto o hash almacenado; nunca reutilizar en texto plano en logs
  scope             InternalApiKeyScope @default(READ_ONLY)
  targetAppOrEngine String // slug del Engine o App autorizado como destinatario de esta llave
  ownerId           String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([targetAppOrEngine])
}

model Bot {
  id        String   @id @default(cuid())
  name      String
  status    String
  modelId   String
  avatarUrl String?
  mainApp   String   @default("misbots")
  /// Columna legada en PostgreSQL (`sourceApp`) conservada para alinear `db push` con tablas que no ejecutaron el paso de renombre a `mainApp`.
  sourceApp String?
  subApp    String?
  metadata  Json?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([mainApp])
}

model Contract {
  id        String   @id @default(cuid())
  title     String
  status    String
  mainApp   String   @default("contratos")
  subApp    String?
  metadata  Json?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([mainApp])
}

model Document {
  id         String   @id @default(cuid())
  name       String
  fileUrl    String
  fileType   String
  size       Int
  bucketPath String
  mainApp    String
  subApp     String?
  metadata   Json?
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
  @@index([mainApp])
}
