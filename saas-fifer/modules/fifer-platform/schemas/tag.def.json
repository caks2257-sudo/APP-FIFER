{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fifer.local/schemas/tag-center/tag.json",
  "title": "TagCenterTag",
  "type": "object",
  "required": ["name", "type", "created_by"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "metrics": { "type": "array", "items": { "type": "object" } },
    "virtues": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "object" } },
    "cost_unit": { "type": "string" },
    "cost_value": { "type": "number" },
    "provider_id": { "type": ["string", "null"], "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "created_by": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "by", "action"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "by": { "type": "string", "format": "uuid" },
          "action": { "type": "string" },
          "patch": { "type": "object" },
          "snapshot": { "type": "object" },
          "version": { "type": "integer" }
        }
      }
    },
    "extra": { "type": "object" }
  },
  "additionalProperties": false
}
