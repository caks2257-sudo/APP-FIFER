{
  "play_id": "sales_explosive_v1",
  "version": "1.0.0",
  "objective": "sales_explosive",
  "summary": "Maximize short-term conversions: rank impulse-friendly SKUs, push flash-discount narrative, short-form reels + carousels, tight A/B on hooks.",
  "product_selection": {
    "source": "tag_ranking",
    "scoring_profile_id": "sales_explosive",
    "filters": {
      "min_score": 55,
      "top_n": 24,
      "require_tags_any": ["intent_impulse", "metric:discount_flash_30", "publish_ig"],
      "exclude_tags_any": ["out_of_stock_signal"]
    },
    "refresh_policy": {
      "job_type": "rank_refresh",
      "cron": "0 */6 * * *",
      "note": "Re-rank every 6h while campaign active"
    }
  },
  "content_formats": [
    {
      "format": "reel",
      "duration_seconds": 15,
      "variants_per_product": 2,
      "hook_style": "problem_agitate_solve",
      "cta": "shop_now"
    },
    {
      "format": "carousel",
      "slides": 5,
      "variants_per_product": 1,
      "cta": "swipe_shop"
    },
    {
      "format": "post",
      "length": "short_caption",
      "variants_per_product": 1
    }
  ],
  "ai_engines": {
    "script_and_structure": "gemini_flash_text",
    "voice": "elevenlabs_tts",
    "video": "runway_video",
    "stills": "leonardo_image",
    "publish_fanout": "make_webhook"
  },
  "estimated_credits": {
    "method": "simulateScenario",
    "reference_lines": [
      { "engineId": "runway_video", "unit": "1s_render", "qty": 15, "note": "per reel" },
      { "engineId": "gemini_flash_text", "unit": "1k_tokens", "qty": 0.8, "note": "per creative" },
      { "engineId": "elevenlabs_tts", "unit": "1k_chars", "qty": 0.4, "note": "per reel VO" }
    ],
    "scenario_overrides": {
      "variation": { "outputs": 2, "multiplier": 1 },
      "parallel": { "jobs": 4, "coordinationOverheadPerExtraJob": 0.05 },
      "retries": { "attempts": 2, "successRate": 0.88, "costFractionPerAttempt": 1 },
      "transcoding": { "overheadPct": 0.08 }
    },
    "per_product_band_credits": { "min": 52, "max": 78 },
    "campaign_total_band_credits": { "min": 1248, "max": 1872, "assumes_products": 24 }
  },
  "timeline": {
    "timezone": "America/New_York",
    "phases": [
      { "phase": "setup", "days": 1, "tasks": ["import_play", "validate_affiliate", "dry_run_rank"] },
      { "phase": "creative_sprint", "days": 3, "tasks": ["render_wave_1", "qa_hooks"] },
      { "phase": "ab_warmup", "days": 2, "tasks": ["5pct_traffic", "monitor_ctr"] },
      { "phase": "scale", "days": 7, "tasks": ["winner_expand", "refresh_rank"] },
      { "phase": "retarget", "days": 3, "tasks": ["carousel_remix", "coupon_push"] }
    ],
    "total_calendar_days": 16
  },
  "kpis": [
    { "id": "ctr", "name": "Click-through rate", "target": 0.035, "unit": "ratio" },
    { "id": "cvr", "name": "Conversion rate", "target": 0.022, "unit": "ratio" },
    { "id": "roas", "name": "Return on ad spend", "target": 2.5, "unit": "multiplier" },
    { "id": "cpc", "name": "Cost per click (affiliate)", "target": 0.45, "unit": "USD" },
    { "id": "credit_per_order", "name": "AI credits per attributed order", "target": 18, "unit": "credits" }
  ],
  "ab_rollout": {
    "strategy": "traffic_split_with_winner",
    "variants": [
      {
        "id": "A",
        "label": "Flash_discount_first",
        "weight": 0.5,
        "creative_bias": { "hook": "discount_led", "format_priority": ["reel", "carousel"] }
      },
      {
        "id": "B",
        "label": "Social_proof_first",
        "weight": 0.5,
        "creative_bias": { "hook": "review_led", "format_priority": ["carousel", "reel"] }
      }
    ],
    "phases": [
      { "name": "warmup", "duration_days": 2, "traffic": { "A": 0.05, "B": 0.05, "holdout": 0.9 } },
      { "name": "main", "duration_days": 7, "traffic": { "A": 0.45, "B": 0.45, "holdout": 0.1 } },
      { "name": "winner", "duration_days": 5, "traffic": { "winner": 0.85, "loser": 0.15 } }
    ],
    "promotion_rule": "After 48h, if ctr_A > ctr_B by margin > 0.2%, shift +10% traffic to A per day until 80/20 or 7d.",
    "guardrails": { "min_impressions_per_variant_per_day": 800, "min_clicks_before_winner": 120 }
  },
  "affiliate_integration": {
    "prefer_networks": ["admitad_aliexpress", "shareasale"],
    "link_enrichment": "append_utm_campaign",
    "disclosure": "required_in_caption"
  }
}
