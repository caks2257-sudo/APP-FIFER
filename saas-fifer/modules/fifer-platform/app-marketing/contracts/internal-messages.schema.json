{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fifer.local/schemas/app-marketing/internal-messages.json",
  "title": "App Marketing internal messages",
  "$defs": {
    "CampaignPlanRequest": {
      "type": "object",
      "required": ["name", "objective_key", "play_template_id", "owner_id"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "objective_key": {
          "type": "string",
          "enum": ["sales_explosive", "high_commission", "viral_growth", "custom"]
        },
        "play_template_id": { "type": "string" },
        "scoring_profile_id": { "type": "string" },
        "owner_id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    },
    "RenderJobPayload": {
      "type": "object",
      "required": ["campaign_id", "product_id", "format"],
      "properties": {
        "campaign_id": { "type": "string", "format": "uuid" },
        "product_id": { "type": "string" },
        "format": { "type": "string", "enum": ["reel", "carousel", "post"] },
        "engine_overrides": { "type": "object" },
        "variant": { "type": "string" },
        "deadline_at": { "type": "string", "format": "date-time" }
      }
    },
    "PublishJobPayload": {
      "type": "object",
      "required": ["campaign_id", "channel", "affiliate_url"],
      "properties": {
        "campaign_id": { "type": "string", "format": "uuid" },
        "channel": { "type": "string" },
        "creative_url": { "type": "string", "format": "uri" },
        "affiliate_url": { "type": "string", "format": "uri" },
        "tracking": { "type": "object" }
      }
    }
  }
}
